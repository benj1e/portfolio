# GoatCounter site code (the part before .goatcounter.com). Leave empty to disable analytics.
VITE_GOATCOUNTER_CODE=
# Base URL of the admin worker, e.g. https://admin.benj1e.workers.dev. Leave empty to disable /admin.
VITE_ADMIN_API=
# Optional endpoint returning { "city": "Halifax", "ago": "2 min ago" } for the visitor log widget.
VITE_VISIT_API=
